# Copy to .env and fill in the values. Do NOT commit your real .env file.

# Public web port
PORT=8000

# Database
DB_NAME=openrepair
DB_USER=openrepair_user
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password
# Only for local development without Docker (Docker uses "db")
DB_HOST=localhost

# Flask session key — generate a random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-key

# Initial admin: created only on first startup when there are no users.
# Change these credentials before exposing the app to the internet.
ADMIN_EMAIL=admin@openrepair.com
ADMIN_PASSWORD=admin123
